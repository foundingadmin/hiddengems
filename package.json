{
  "name": "hiddengems",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test && pnpm lint:color",
    "lint:color": "node packages/facet/scripts/lint-color.mjs apps",
    "db:generate": "pnpm --filter @hiddengems/db generate",
    "db:migrate": "pnpm --filter @hiddengems/db migrate",
    "job": "pnpm --filter @hiddengems/ingest job"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
