# Copy to apps/web/.env.local for `pnpm dev`, or export before `pnpm job` and `pnpm db:migrate`.
# On Vercel, set these per environment (Secret type for keys and URLs).

# Postgres (Neon or Supabase via the Vercel Marketplace). Unset locally: PGlite in .data/pglite.
DATABASE_URL=

# sample (no keys, the default without ODDS_API_KEY) or live
DATA_MODE=sample

# The Odds API (https://the-odds-api.com): player prop prices
ODDS_API_KEY=
# Markets to pull, comma separated (ids from packages/core/src/markets.ts). Each costs quota per game.
ODDS_MARKETS=anytime_td,receptions

# SportsDataIO NFL (https://sportsdata.io): schedule, rosters with jersey numbers, results
SPORTSDATAIO_KEY=

# Vercel cron sends "Authorization: Bearer $CRON_SECRET" (16+ random characters)
CRON_SECRET=

# Private app: HTTP Basic password for every page. Required on Vercel; the app stays closed without it.
APP_PASSWORD=

# Clock times on screen (default America/New_York)
DISPLAY_TIME_ZONE=America/New_York
