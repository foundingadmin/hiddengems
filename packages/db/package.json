{
  "name": "@hiddengems/db",
  "version": "0.1.0",
  "private": true,
  "description": "Hidden Gems data: Postgres schema (Drizzle), migrations, client and seed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "restore": "tsx src/scripts/restore.ts",
    "supabase-sql": "tsx src/scripts/supabase-sql.ts",
    "supabase-apply": "tsx src/scripts/supabase-apply.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@hiddengems/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
