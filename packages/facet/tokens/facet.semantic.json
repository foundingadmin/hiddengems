{
  "$description": "Facet semantic layer. Every value is an alias to a Facet primitive ({color.<scale>.<step>}). Light/dark switching happens in the primitive layer, so aliases never need a dark override unless the step itself changes per theme ($extensions.facet.dark). Rule: product code uses these names first, primitives second, raw values never.",
  "text": {
    "primary": {
      "$type": "color",
      "$value": "{color.gray.1000}",
      "$description": "Body copy, values and icons."
    },
    "secondary": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$description": "Labels, metadata and supporting copy. The lowest step allowed for readable text."
    },
    "disabled": {
      "$type": "color",
      "$value": "{color.gray.700}",
      "$description": "Disabled controls only, never meaningful copy."
    },
    "inverse": {
      "$type": "color",
      "$value": "{color.background.100}",
      "$description": "Copy on a gray-1000 fill, such as primary buttons and selected tabs."
    },
    "link": {
      "$type": "color",
      "$value": "{color.blue.900}",
      "$description": "Inline links."
    }
  },
  "surface": {
    "canvas": {
      "$type": "color",
      "$value": "{color.background.100}",
      "$description": "Pages and components. Use in most instances."
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.background.200}",
      "$description": "Sparingly, for sidebars, wells and the table header band."
    },
    "fill": {
      "$type": "color",
      "$value": "{color.gray.100}",
      "$description": "Resting fill for chips, rows and small controls."
    },
    "fill-hover": {
      "$type": "color",
      "$value": "{color.gray.200}",
      "$description": "Hovered fill. On a canvas-colored component, hover uses gray-100 instead."
    },
    "fill-active": {
      "$type": "color",
      "$value": "{color.gray.300}",
      "$description": "Pressed and selected fill."
    },
    "contrast": {
      "$type": "color",
      "$value": "{color.gray.1000}",
      "$description": "Primary buttons and the selected segmented control."
    },
    "contrast-hover": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$description": "Primary button hover."
    }
  },
  "border": {
    "default": {
      "$type": "color",
      "$value": "{color.gray.400}",
      "$description": "Dividers and resting edges. Solid gray, never alpha, by default."
    },
    "hover": {
      "$type": "color",
      "$value": "{color.gray.500}",
      "$description": "Edges under the pointer."
    },
    "active": {
      "$type": "color",
      "$value": "{color.gray.600}",
      "$description": "Pressed or focused edges."
    },
    "alpha": {
      "$type": "color",
      "$value": "{color.gray-alpha.400}",
      "$description": "Only where an edge must blend with a tinted surface. Overlapping alpha edges darken where they cross."
    }
  },
  "focus": {
    "color": {
      "$type": "color",
      "$value": "{color.blue.700}",
      "$extensions": {
        "facet": {
          "dark": "{color.blue.900}"
        }
      },
      "$description": "Matches --ds-focus-color (blue-700 light, blue-900 dark)."
    }
  },
  "status": {
    "info": {
      "fg": {
        "$type": "color",
        "$value": "{color.blue.900}",
        "$description": "Info text and icons."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.blue.700}",
        "$description": "Info dot or solid mark."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.blue.200}",
        "$description": "Info note fill."
      },
      "border": {
        "$type": "color",
        "$value": "{color.blue.400}",
        "$description": "Info note border."
      }
    },
    "success": {
      "fg": {
        "$type": "color",
        "$value": "{color.green.900}",
        "$description": "Success text and icons."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.green.700}",
        "$description": "Success dot or solid mark."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.green.200}",
        "$description": "Success note fill."
      },
      "border": {
        "$type": "color",
        "$value": "{color.green.400}",
        "$description": "Success note border."
      }
    },
    "warning": {
      "fg": {
        "$type": "color",
        "$value": "{color.amber.900}",
        "$description": "Warning text and icons."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.amber.700}",
        "$description": "Warning dot or solid mark."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.amber.200}",
        "$description": "Warning note fill."
      },
      "border": {
        "$type": "color",
        "$value": "{color.amber.400}",
        "$description": "Warning note border."
      }
    },
    "error": {
      "fg": {
        "$type": "color",
        "$value": "{color.red.900}",
        "$description": "Error text and icons."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.red.700}",
        "$description": "Error dot or solid mark."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.red.200}",
        "$description": "Error note fill."
      },
      "border": {
        "$type": "color",
        "$value": "{color.red.400}",
        "$description": "Error note border and invalid input ring."
      }
    },
    "neutral": {
      "fg": {
        "$type": "color",
        "$value": "{color.gray.900}",
        "$description": "Neutral status text."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.gray.700}",
        "$description": "Neutral status dot."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$description": "Neutral status fill."
      },
      "border": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$description": "Neutral status border."
      }
    }
  },
  "signal": {
    "$description": "Hidden Gems verdict language (the prototype's go / wait / stop / none). Always paired with a non-color cue: a word, a glyph, or a position. Color alone never carries the verdict.",
    "go": {
      "fg": {
        "$type": "color",
        "$value": "{color.green.900}",
        "$description": "The word \"Go\" and go-colored text."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.green.700}",
        "$description": "Go dot in the verdict and the signal strip."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.green.200}",
        "$description": "Go pill fill."
      }
    },
    "wait": {
      "fg": {
        "$type": "color",
        "$value": "{color.amber.900}",
        "$description": "The word \"Wait\"."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.amber.700}",
        "$description": "Wait dot."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.amber.200}",
        "$description": "Wait pill fill."
      }
    },
    "stop": {
      "fg": {
        "$type": "color",
        "$value": "{color.red.900}",
        "$description": "The word \"Stop\"."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.red.700}",
        "$description": "Stop dot."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.red.200}",
        "$description": "Stop pill fill."
      }
    },
    "none": {
      "fg": {
        "$type": "color",
        "$value": "{color.gray.900}",
        "$description": "The word \"Unchecked\"."
      },
      "solid": {
        "$type": "color",
        "$value": "{color.gray.600}",
        "$description": "Unchecked dot or hollow ring."
      },
      "bg": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$description": "Unchecked pill fill."
      }
    }
  },
  "edge": {
    "$description": "Value relative to the market (our price vs the book). Positive and negative are about the bettor's value, never about the number going up or down.",
    "positive": {
      "$type": "color",
      "$value": "{color.green.900}",
      "$description": "Gap in the bettor's favor (with an up arrow and a plus sign)."
    },
    "negative": {
      "$type": "color",
      "$value": "{color.red.900}",
      "$description": "Gap against the bettor (with a down arrow and a minus sign)."
    },
    "neutral": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$description": "No meaningful gap."
    }
  },
  "gem": {
    "$description": "HARD RULE: purple belongs to gems and nothing else. It marks 'this is a Hidden Gem' and the ordinal gem tier ladder. Never for links, buttons, focus, selection, highlights, chart series, decoration or any other meaning. It deliberately avoids green/amber/red (verdicts) and blue (links, focus, info).",
    "fg": {
      "$type": "color",
      "$value": "{color.purple.900}",
      "$description": "Gem text, labels and the tier word."
    },
    "solid": {
      "$type": "color",
      "$value": "{color.purple.700}",
      "$description": "Gem mark and solid gem fills."
    },
    "bg": {
      "$type": "color",
      "$value": "{color.purple.200}",
      "$description": "Gem badge and highlight fill."
    },
    "border": {
      "$type": "color",
      "$value": "{color.purple.400}",
      "$description": "Gem badge or panel border."
    },
    "tier": {
      "$description": "Ordinal ladder (rough < cut < polished < flawless). One hue, rising intensity, so rank reads as magnitude. Pair with filled-facet glyph count (1 to 4).",
      "rough": {
        "$type": "color",
        "$value": "{color.gray.700}",
        "$description": "Tier 1 of 4 facets. Gray, because a rough stone is not yet a gem."
      },
      "cut": {
        "$type": "color",
        "$value": "{color.purple.600}",
        "$description": "Tier 2 of 4 facets."
      },
      "polished": {
        "$type": "color",
        "$value": "{color.purple.700}",
        "$description": "Tier 3 of 4 facets."
      },
      "flawless": {
        "$type": "color",
        "$value": "{color.purple.900}",
        "$description": "Tier 4 of 4 facets, the strongest purple."
      }
    }
  },
  "freshness": {
    "$description": "How recent a data point is (odds pull, injury report). Mirrors the status dot semantics.",
    "live": {
      "$type": "color",
      "$value": "{color.green.700}",
      "$description": "Pulled within the live window."
    },
    "recent": {
      "$type": "color",
      "$value": "{color.blue.700}",
      "$description": "Recent but not live."
    },
    "stale": {
      "$type": "color",
      "$value": "{color.amber.700}",
      "$description": "Old enough to re-check before acting."
    },
    "failed": {
      "$type": "color",
      "$value": "{color.red.700}",
      "$description": "The last refresh failed; values are the last good pull."
    },
    "unknown": {
      "$type": "color",
      "$value": "{color.gray.600}",
      "$description": "No timestamp available."
    }
  },
  "chart": {
    "$description": "Monochrome first (Vercel's own report foundation maps chart-1..6 to grays). Series hues come only from hues with no other job (teal, pink) plus blue, so a chart can never be mistaken for a verdict (green/amber/red) or a gem (purple). Exception: a chart that encodes verdicts or gems uses the --fc-signal-* or --fc-gem-* tokens. Order is fixed so a series keeps its color across views.",
    "1": {
      "$type": "color",
      "$value": "{color.gray.1000}",
      "$description": "First series. Gray-1000, monochrome first."
    },
    "2": {
      "$type": "color",
      "$value": "{color.blue.700}",
      "$description": "Second series."
    },
    "3": {
      "$type": "color",
      "$value": "{color.teal.700}",
      "$description": "Third series."
    },
    "4": {
      "$type": "color",
      "$value": "{color.pink.700}",
      "$description": "Fourth series."
    },
    "5": {
      "$type": "color",
      "$value": "{color.gray.700}",
      "$description": "Fifth series, back to gray."
    },
    "6": {
      "$type": "color",
      "$value": "{color.gray.500}",
      "$description": "Sixth series, lighter gray."
    },
    "muted": {
      "$type": "color",
      "$value": "{color.gray.600}",
      "$description": "De-emphasized series, comparison baseline, market line."
    },
    "grid": {
      "$type": "color",
      "$value": "{color.gray.300}",
      "$description": "Chart gridlines."
    },
    "axis": {
      "$type": "color",
      "$value": "{color.gray.500}",
      "$description": "Chart axes and ticks."
    }
  },
  "badge": {
    "$description": "Solid badge fills, measured per theme on the vercel.com reference badge (it uses different steps in light and dark). Text is white except amber (black).",
    "gray": {
      "$type": "color",
      "$value": "{color.gray.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.gray.500}"
        }
      }
    },
    "blue": {
      "$type": "color",
      "$value": "{color.blue.800}"
    },
    "purple": {
      "$type": "color",
      "$value": "{color.purple.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.purple.500}"
        }
      }
    },
    "amber": {
      "$type": "color",
      "$value": "{color.amber.700}"
    },
    "red": {
      "$type": "color",
      "$value": "{color.red.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.red.800}"
        }
      }
    },
    "pink": {
      "$type": "color",
      "$value": "{color.pink.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.pink.600}"
        }
      }
    },
    "green": {
      "$type": "color",
      "$value": "{color.green.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.green.600}"
        }
      }
    },
    "teal": {
      "$type": "color",
      "$value": "{color.teal.900}",
      "$extensions": {
        "facet": {
          "dark": "{color.teal.600}"
        }
      }
    }
  }
}